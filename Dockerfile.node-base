# Copy to Dockerfile. The build context needs package.json and package-lock.json.
# The runtime user is the image's node user. Change CMD to the client entrypoint.

FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS build

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .

FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS runtime

ENV NODE_ENV=production
WORKDIR /src
COPY --from=build --chown=node:node /src /src
USER node
CMD ["node", "src/index.js"]
